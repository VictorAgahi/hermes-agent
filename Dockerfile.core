FROM python:3.12-slim

# Invariant 2 : Environnement Python leger sans PyTorch pour respecter le budget de 900 Mo RAM
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MALLOC_ARENA_MAX=2 \
    PYTHONPATH="/app"

WORKDIR /app

# Installation des dependances systeme minimales
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Installation des dependances Python directes et figees
RUN pip install --no-cache-dir \
    "python-telegram-bot>=21.0,<23.0" \
    "redis>=5.0.0" \
    "psycopg2-binary>=2.9.9" \
    "protobuf>=5.29.0"

# Copie du code source et des contrats Protobuf compiles
COPY hermes_proto /app/hermes_proto
COPY src /app/src

# Execution du point d'entree unifie Hermes Core en Long Polling
CMD ["python", "-m", "src.main"]
